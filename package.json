    "lint": "eslint src/lib/web src/lib/server src/routes/api src/routes/share src/routes/+page.svelte tests",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "test:native": "node scripts/test-native.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
